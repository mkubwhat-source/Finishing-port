{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed",
          "on_shelf"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "hearthandharvest:item/2d_farmers_hat"
        }
      },
      {
        "when": [
          "head"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "hearthandharvest:item/3d_farmers_hat"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "hearthandharvest:item/2d_farmers_hat"
    }
  }
}
